# Environment Configuration for ISCI Management System
#
# Copy this file to .env and update with your values
#
# Usage:
#   cp .env.example .env
#   nano .env  # Edit with your values

# Node environment
NODE_ENV=production

# Server port (PM2 will use this)
PORT=3000

# Database Connection
# For local development (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# For production (PostgreSQL on EC2)
# DATABASE_URL="postgresql://isci_user:YOUR_PASSWORD@localhost:5432/isci_mgmt"

# Optional: AWS configuration for backups
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your_backup_bucket
